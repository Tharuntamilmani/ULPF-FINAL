# ═══════════════════════════════════════════════════════════════════════════════
# ULPF M6 Control Plane — Environment Configuration
# Copy to .env and fill in all required values.
# NEVER commit the actual .env file.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Initial admin user (used by seed script only) ─────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ulpf.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=m6_control_plane
POSTGRES_USER=m6user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_CONFIG_TTL_SECONDS=3600     # TTL for config keys (0 = no expiry)

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT # PLAINTEXT | SASL_SSL
KAFKA_SASL_MECHANISM=             # PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONFIG_TOPIC=ulpf.m6.config.updates
KAFKA_REPLAY_TOPIC=ulpf.replay
KAFKA_ENABLED=true

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_SECURE=false
MINIO_BUCKET_CONTRACTS=ulpf-contracts
MINIO_BUCKET_SCHEMAS=ulpf-schemas

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=CHANGE_ME_OPENSEARCH_PASSWORD
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── External M1–M5 service URLs (leave empty when not deployed) ───────────────
# M6 integration adapters use these. Set UNAVAILABLE behaviour is automatic.
M1_BASE_URL=http://localhost:8001
M2_BASE_URL=http://localhost:8002
M3_BASE_URL=http://localhost:8003
M4_BASE_URL=http://localhost:8004
M5_BASE_URL=http://localhost:8005

# Health check timeout for external services (seconds)
EXTERNAL_HEALTH_TIMEOUT_SECONDS=5
EXTERNAL_HEALTH_RETRY_ATTEMPTS=2

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ── Feature flags ─────────────────────────────────────────────────────────────
USE_MOCK_ADAPTERS=false           # Set true in CI / offline dev (overrides real adapters)
ENABLE_AUDIT_LOG=true
ENABLE_CONFIG_DISTRIBUTION=true
ENABLE_REPLAY=true
