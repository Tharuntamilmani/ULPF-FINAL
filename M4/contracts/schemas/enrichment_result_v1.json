{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulpf.local/schemas/m4/enrichment_result_v1.json",
  "title": "EnrichmentResultv1",
  "description": "ULPF M4 Standalone Enrichment Result Contract",
  "type": "object",
  "required": ["event", "status", "provenance", "diagnostics", "integrity"],
  "properties": {
    "event": { "$ref": "canonical_ues_v1.json" },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "FAILED", "SKIPPED", "TIMEOUT", "NOT_FOUND"]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider_id", "provider_version", "enrichment_type", "confidence", "result_status"],
        "properties": {
          "provider_id": { "type": "string" },
          "provider_version": { "type": "string" },
          "enrichment_type": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "result_status": { "type": "string" },
          "cache_status": { "type": "string", "enum": ["HIT", "MISS", "BYPASS"] }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["total_duration_ms"]
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "digest", "canonicalization", "phase"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "canonicalization": { "type": "string", "const": "rfc8785" },
        "phase": { "type": "string" }
      }
    }
  }
}
