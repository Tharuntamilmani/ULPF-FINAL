# ═══════════════════════════════════════════════════════════════════════════════
# ULPF — Root-Level Environment Configuration
# Used by: run_stack.py orchestrator and integration layer services
#
# Module-specific .env files are located in:
#   M1/modules/m1-ingestion/.env.example
#   M3/.env.example
#   M5/.env.example
#   M6/M6-SIH-main/.env.example
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (Local Instance) ───────────────────────────────────────────────
# Used by run_stack.py to verify database readiness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ulpf_m6
POSTGRES_USER=ulpf_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ── M6 Control Plane ─────────────────────────────────────────────────────────
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Infrastructure Endpoints ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminsecret
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

# ── M1 Ingestion ─────────────────────────────────────────────────────────────
API_AUTH_TOKEN=sec-m1-token-sysadmin-9901

# ── Service URLs (Internal) ──────────────────────────────────────────────────
M1_BASE_URL=http://127.0.0.1:18001
M2_BASE_URL=http://127.0.0.1:18082
M3_BASE_URL=http://127.0.0.1:18083
M4_BASE_URL=http://127.0.0.1:18004
M5_BASE_URL=http://127.0.0.1:18085

# ── Orchestrator Options ─────────────────────────────────────────────────────
# Set to "1" to skip Docker container start/stop (if managing containers manually)
# ULPF_SKIP_CONTAINER_START=0
# Kafka readiness probe timeout (seconds)
# ULPF_KAFKA_TIMEOUT=45
# MinIO readiness probe timeout (seconds)
# ULPF_MINIO_TIMEOUT=20
