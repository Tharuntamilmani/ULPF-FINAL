# ==============================================================================
# ULPF MODULE M5 - POLICY ENGINE + SMART ROUTER CONFIGURATION
# ==============================================================================

# Service Configuration
PORT=8085
HOST=0.0.0.0
POLICY_FILE_PATH=./policies/default.yaml

# Security & Tenant Isolation
# Comma-separated allowed origins for CORS (wildcard disables credentials)
ALLOWED_ORIGINS=*
# Set to 'false' in production; when true, permits unauthenticated dev access
M5_ALLOW_ANONYMOUS=false
# Optional JSON dictionary of custom API keys to tenant mapping
# Example: '{"key-1": {"tenant_id": "tenant_custom", "is_admin": false}}'
M5_API_KEYS=

# OpenSearch SIEM Destination
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=ulpf-events
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_MOCK_MODE=true

# Data Lake Destination
DATA_LAKE_MOCK_MODE=true
DATA_LAKE_LOCAL_PATH=./data/datalake
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ulpf-datalake

# AI/ML Stream Destination
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_MOCK_MODE=true
AI_STREAM_TOPIC=ulpf.ai.events

# HTTP Webhook Destination
HTTP_WEBHOOK_URL=http://localhost:9090/webhook
HTTP_MOCK_MODE=true

# Delivery Guarantees & Retry Engine
MAX_DELIVERY_RETRIES=3
INITIAL_RETRY_BACKOFF_SEC=0.05
DLQ_LOCAL_PATH=./data/dlq
