# ==============================================================================
# ULPF Full System Integration Environment Configuration
# All container inter-service communication uses container service names (never localhost)
# Host port bindings resolve all port collisions:
#   M1 Backend: 8001 (was colliding with M6 on 8000)
#   M2 Backend: 8082
#   M3 Backend: 8083 (Frontend: 5174, was colliding with M6 on 5173)
#   M4 Backend: 8004
#   M5 Backend: 8085
#   M6 Backend: 8086 (Frontend: 5173)
#   Ingress Security Gateway: 8080
#   Configuration Sync Worker: 8081
#   System Health Aggregator: 8090
# ==============================================================================

# Internal Service Discovery URLs (Within Docker Network)
M1_INTERNAL_URL=http://m1:8000
M2_INTERNAL_URL=http://m2:8000
M3_INTERNAL_URL=http://m3:8000
M4_INTERNAL_URL=http://m4:8000
M5_INTERNAL_URL=http://m5:8000
M6_INTERNAL_URL=http://m6:8000
INGRESS_GATEWAY_URL=http://ingress-gateway:8080
CONFIG_SYNC_URL=http://config-sync:8081
HEALTH_AGGREGATOR_URL=http://health-aggregator:8090

# Host-Mapped Ports
M1_HOST_PORT=8001
M2_HOST_PORT=8082
M3_HOST_PORT=8083
M3_UI_HOST_PORT=5174
M4_HOST_PORT=8004
M5_HOST_PORT=8085
M6_HOST_PORT=8086
M6_UI_HOST_PORT=5173
GATEWAY_HOST_PORT=8080
CONFIG_SYNC_HOST_PORT=8081
HEALTH_HOST_PORT=8090

# Infrastructure
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=9092
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6379
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_HOST_PORT=9200
POSTGRES_DB=ulpf_m6
POSTGRES_USER=ulpf_admin
POSTGRES_PASSWORD=ulpf_secure_password
POSTGRES_HOST_PORT=5432

# Service Authentication Keys
M1_INTERNAL_TOKEN=sec-m1-token-sysadmin-9901
M2_SERVICE_TOKEN=system-admin-token
M3_SERVICE_KEY=sec-m3-key-sysadmin-9903
M4_SERVICE_TOKEN=system-admin-token
M5_SERVICE_TOKEN=admin
M6_SERVICE_TOKEN=sec-m6-key-control-9906
