# ULPF M1 Ingestion Module Configuration

# Security & Authentication
API_AUTH_TOKEN=changeme_in_env_file

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=ulpf.raw
KAFKA_TOPIC_DLQ=ulpf.dlq
KAFKA_TOPIC_REPLAY=ulpf.replay

# MinIO Raw Vault Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=ulpf-raw
MINIO_SECURE=false

# Listener Ports & Host Binding
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
UDP_PORT=514
TCP_PORT=515

# Rate Limiting (Token Bucket)
MAX_EVENTS_PER_SECOND=1000
BURST_SIZE=2000

# Metadata Defaults
DEFAULT_TENANT_ID=demo-tenant
DEFAULT_SOURCE_ID=collector-source-01
DEFAULT_SOURCE_TYPE=firewall
DEFAULT_INGEST_ZONE=dmz
DEFAULT_COLLECTOR_ID=collector-01
